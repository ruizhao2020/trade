# ============================================================================
# ECS 部署配置模板
# ============================================================================
#
# 用法：cp deploy/ecs/.env.example deploy/ecs/.env
#      （.env 已被仓库 .gitignore 的 `**/.env` 忽略，不要提交）
#
# 这份文件同时被两处读取：
#   1. docker compose 用来插值 ${MYSQL_ROOT_PASSWORD} 这类变量；
#   2. 后端容器（env_file）——所有 SIGNAL_ 前缀的键都是后端配置项。
# 生成随机串：openssl rand -base64 32

# ── MySQL ────────────────────────────────────────────────────────────────
# 只会用于容器内部的 root 账号，密码不对外暴露，但仍然按秘密对待
MYSQL_ROOT_PASSWORD=请替换成随机密码

# 后端使用的业务账号（首次启动由 mysql 容器自动创建并授权到下面的库）
SIGNAL_MYSQL_USER=signal
SIGNAL_MYSQL_PASSWORD=请替换成另一个随机密码
SIGNAL_MYSQL_DATABASE=signal_layer
# 容器名即主机名（compose 内部网络），不要改成 localhost
SIGNAL_MYSQL_HOST=mysql
SIGNAL_MYSQL_PORT=3306

# ── Redis ────────────────────────────────────────────────────────────────
SIGNAL_REDIS_HOST=redis
SIGNAL_REDIS_PORT=6379
SIGNAL_REDIS_DB=0
# Redis 不发布端口、只在内部网络，留空即可；要对公网暴露必须先设密码
SIGNAL_REDIS_PASSWORD=

# ── 后端 ─────────────────────────────────────────────────────────────────
# 生产必须 false：为 true 时错误详情会返回给客户端，且会跳过 token 密钥检查
SIGNAL_DEBUG=false
# 生产必填。留成默认值时 app/main.py 会直接拒绝启动（这是故意的保护）
SIGNAL_TOKEN_SECRET=请替换成至少 32 位随机串
SIGNAL_TOKEN_EXPIRE_MINUTES=1440
# 首次启动时创建的管理员（已存在则只做补权限，不会改密码）
SIGNAL_BOOTSTRAP_ADMIN_USERNAME=admin
SIGNAL_BOOTSTRAP_ADMIN_PASSWORD=请替换成强密码
# 前端走同源 /api，浏览器不会触发跨域；这里仍然写上，
# 以后把接口拆到 api. 子域时不用再改代码。
SIGNAL_CORS_ORIGINS=https://caopan.me,https://work.caopan.me

# ── 证书 ─────────────────────────────────────────────────────────────────
# 用于 Let's Encrypt 到期提醒
ACME_EMAIL=你的邮箱@example.com
