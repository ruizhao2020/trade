# ============================================================================
# 前端镜像（两个入口打成一个 nginx 镜像：公开站 + 私有站）
# ============================================================================
#
# 为什么把两套产物放进同一个镜像：两个域名只差一个 root，其余（TLS、/api 反代、
# gzip、缓存）完全一样。分开成两个容器再套一层边缘 nginx 只是多一跳、多一处配置。
# 需要独立发布节奏时再用 deploy/k8s/ 下那套（一份代码两个镜像）。
#
# 构建上下文必须是**仓库根目录**：
#
#   docker build -f deploy/ecs/Dockerfile.frontend -t signal-layer-frontend .
#
# VITE_API_BASE 默认走**同源相对路径** /api/v1：请求由 nginx 反代到后端，
# 不产生跨域、也不把域名写死在产物里（换域名/加 CDN 都不用重新构建前端）。

FROM node:22-alpine AS build
WORKDIR /app
COPY signal-layer/package.json signal-layer/package-lock.json ./
RUN npm ci
COPY signal-layer/ ./

ARG VITE_API_BASE=/api/v1
ENV VITE_API_BASE=${VITE_API_BASE}
# 两个 mode 各产一份：public 入口不含登录/私有模块，private 入口是完整工作区。
# vite.config.ts 会按 mode 改写 index.html 里的入口文件，因此必须分别构建。
RUN npm run build:public && npm run build:private

FROM nginx:1.27-alpine
# 两套产物各自一个 root，由 edge.conf 按 server_name 区分
COPY --from=build /app/dist-public /usr/share/nginx/public
COPY --from=build /app/dist-private /usr/share/nginx/private
COPY deploy/ecs/nginx/edge.conf /etc/nginx/conf.d/default.conf
COPY deploy/ecs/nginx/api-proxy.conf /etc/nginx/snippets/api-proxy.conf
EXPOSE 80 443
