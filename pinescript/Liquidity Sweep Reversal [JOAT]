// HELPERS 辅助函数
// Pine Script 函数语法:f_name(arg1, arg2) =>
//   表达式1
//   表达式2   ← 最后一行的表达式即为返回值
// 返回值可以单一或为元组(多返回值)。
//──────────────────────────────────────────────────────────────────────

// 将字符串映射为 Pine 内置的尺寸常量(用于 label/表格字号)
f_size(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.small

// 将字符串映射为表格位置常量
f_pos(string p) =>
    switch p
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Bottom Left"  => position.bottom_left
        "Bottom Right" => position.bottom_right
        "Middle Right" => position.middle_right
        => position.top_right

// 将 R 值格式化为带符号字符串,例如 +1.5R / -1R
f_signedR(float v) => (v >= 0 ? "+" : "") + str.tostring(v, "#.##") + "R"

// 找出数组中"被当前 bar 的 low 刺穿的、最高的摆动低点"
// 逻辑:遍历所有保存的摆动低点,寻找 low < v 中 v 最大的那个(即最接近现价的下方流动性)
// 返回该元素在数组中的下标,找不到返回 -1
f_nearestLow(array<float> arr, float lo) =>
    int idx = -1
    float best = na
    int n = array.size(arr)
    if n > 0
        for i = 0 to n - 1
            float v = array.get(arr, i)
            if lo < v and (idx == -1 or v > best)
                best := v          // := 是"重新赋值"运算符(在函数局部修改变量)
                idx := i
    idx

// 同上,找出被当前 high 刺穿的、最低的摆动高点(最接近现价的上方流动性)
f_nearestHigh(array<float> arr, float hi) =>
    int idx = -1
    float best = na
    int n = array.size(arr)
    if n > 0
        for i = 0 to n - 1
            float v = array.get(arr, i)
            if hi > v and (idx == -1 or v < best)
                best := v
                idx := i
    idx

